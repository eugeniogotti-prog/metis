# Configurazione di Metis: una riga CHIAVE=valore. Il file si legge e non si esegue.
# Posizione: ~/.config/metis/config (oppure il percorso in METIS_CONFIG).

# Nome del prodotto nei messaggi (una sola variabile, da cambiare qui se il nome cambia).
METIS_PRODOTTO=Metis

# Radice del vault.
METIS_VAULT=~/Documents/Vault

# Cartella dei documenti: con «accanto» (default) è la cartella dei progetti del vault e non si scrive;
# con METIS_DOCUMENTI=separati è una cartella fuori dal vault, per esempio:
# METIS_FONTI=~/Documents/Fonti

# Mappatura ruolo → cartella, relativa alla radice del vault. Vault nuovo: i valori sotto (PARA).
# Vault esistente: la skill di installazione propone la mappatura sulle cartelle del cliente, senza spostare note.
METIS_RUOLO_INBOX=0 - Inbox
METIS_RUOLO_PROGETTI=1 - Progetti
METIS_RUOLO_AREE=2 - Aree
METIS_RUOLO_RISORSE=3 - Risorse
METIS_RUOLO_ARCHIVIO=4 - Archivio
METIS_RUOLO_PERSONE=3 - Risorse/Persone
METIS_RUOLO_JOURNAL=Journal
METIS_RUOLO_TEMPLATE=_Extras/_Templates
METIS_RUOLO_CLAUDE=_Claude
# Cartella riservata: vuota se non c'è.
METIS_RUOLO_RISERVATA=

# Sottocartelle dell'Inbox attive, una per fonte.
METIS_INBOX_FONTI=Clippings files voicenotes

# Chiavi del frontmatter che ogni nota deve avere, e prefissi dei tag controllati dal doctor
# (vuoto = controllo dei tag spento, se il cliente non adotta i tag con prefisso).
METIS_FRONTMATTER_CHIAVI=created_at tags up
METIS_TAG_PREFISSI=tipo argomento contenuto status

# Mappa delle cartelle e archivio (scripts/mappa.py, skill archiviazione). Tutte facoltative.
# Radici da fotografare ogni giorno, separate da «|», relative al vault o assolute (default: lavori, archivio, fonti).
# {anno} vale l'anno corrente (o la cartella più recente, se quella dell'anno non c'è ancora).
# METIS_MAPPA_RADICI=Clienti|Chiusi|~/Documents/Fonti|~/Drive/{anno} attività in corso
# Cartelle di primo livello delle fonti i cui figli sono lavori distinti, separate da «|».
# METIS_MAPPA_CONTENITORI=Gare|Consulenze
# Giorni senza attività oltre i quali un lavoro è proposto per l'archivio.
# METIS_MAPPA_GIORNI_FERMO=90
# Archivio del vault con una cartella per anno (sì) o piatto (no).
METIS_ARCHIVIO_PER_ANNO=sì
# Posta delle sessioni: «connettori» (default, connettore Gmail di claude.ai) o «locale» (server locale, google.sh posta).
# METIS_POSTA=connettori

# Documenti: «accanto» (default: una cartella per lavoro con note e documenti insieme, nella struttura PARA del vault;
# la cartella fonti è quella dei progetti) o «separati» (vault di Obsidian con sole note, documenti in METIS_FONTI fuori).
# METIS_DOCUMENTI=accanto

# Cartella dove spostare a fine lavoro le cartelle su disco; vuota = restano dove sono (consigliato).
METIS_FONTI_ARCHIVIO=

# LaunchAgent: prefisso delle etichette e job installati.
METIS_LABEL=com.metis.utente
METIS_JOBS=daily-digest inbox-processor
METIS_LOG_DIR=~/Library/Logs/metis

# Memoria di Claude Code del vault: si ricava dal percorso del vault; fissarla qui solo se il ricavo non torna.
# METIS_MEMORY_DIR=~/.claude/projects/-Users-utente-Documents-Vault/memory
